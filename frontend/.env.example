# ══════════════════════════════════════════════════════════════════════════════
# Wazire Frontend — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# All variables must be prefixed with VITE_ to be exposed to the browser bundle.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
VITE_APP_NAME=wazire
# Runtime environment: development | test | production
VITE_ENV=development
# Set to false in production to suppress verbose console output
VITE_DEBUG=false

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL for all API requests. In production this is the nginx-proxied path.
VITE_API_BASE_URL=/api/v1
VITE_API_VERSION=v1
# Used by the Vite dev-server proxy to forward /api/v1 requests to the backend
VITE_PROXY_TARGET=http://localhost:8000

# ── Authentication ────────────────────────────────────────────────────────────
# localStorage key under which the JWT access token is stored
VITE_TOKEN_KEY=access_token
# Mirror of the backend ACCESS_TOKEN_EXPIRE_SECONDS (used for client-side expiry hints)
VITE_TOKEN_EXPIRE_SECONDS=3600

# ── Pagination ────────────────────────────────────────────────────────────────
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# ── Timeouts (milliseconds) ───────────────────────────────────────────────────
# Default axios request timeout
VITE_API_TIMEOUT=30000
# Timeout for file upload requests (answer sheet scans, etc.)
VITE_UPLOAD_TIMEOUT=300000

# ── File Upload ───────────────────────────────────────────────────────────────
# Maximum allowed upload size in bytes (default: 10 MB)
VITE_MAX_FILE_SIZE=10485760

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Enable the analytics dashboard section
VITE_ENABLE_ANALYTICS=false
# Enable Sentry / error reporting integration
VITE_ENABLE_ERROR_REPORTING=false
# Enable Web Vitals / performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# ── Cache ─────────────────────────────────────────────────────────────────────
# React Query staleTime in seconds
VITE_CACHE_TTL=300
VITE_ENABLE_CACHE=true

# ── Theme ─────────────────────────────────────────────────────────────────────
# Default colour scheme: light | dark | system
VITE_DEFAULT_THEME=system
# Primary brand colour (Tailwind / CSS variable seed)
VITE_PRIMARY_COLOR=#4F46E5

# ── WebSocket ─────────────────────────────────────────────────────────────────
# WebSocket base URL for real-time exam events (proxied through nginx /ws/)
VITE_WS_BASE_URL=ws://localhost/ws

# ── PWA ───────────────────────────────────────────────────────────────────────
# Set to true to register the service worker in development (useful for PWA testing)
VITE_PWA_DEV_ENABLED=false
