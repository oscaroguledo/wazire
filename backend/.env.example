# Application Configuration
APP_NAME=wazire
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me-in-production

# Database Configuration
DATABASE_URL=postgresql+asyncpg://wazire:wazire@pgbouncer:6432/wazire
POSTGRES_DB=wazire
POSTGRES_USER=wazire
POSTGRES_PASSWORD=wazire
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_PORT=6379

# Kafka-based worker and scheduler are used for background jobs

# Kafka Configuration
# Bootstrap servers may be a comma-separated list, e.g. kafka:9092,other:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Optional prefix for application topics
KAFKA_TOPIC_PREFIX=wazire
# If using SASL auth, set USER/PASS and SECURITY_PROTOCOL/SASL_MECHANISM
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=

# JWT Configuration
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# API Keys
# Comma-separated list of Groq API keys for rotation/throughput (e.g. key1,key2)
GROQ_API_KEYS=
BREVO_API_KEY=
BREVO_SENDER_NAME=Wazire
BREVO_SENDER_EMAIL=sender@yourdomain.com
# Payment webhook secret used to validate incoming payment provider callbacks (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=

# Frontend Configuration
FRONTEND_PORT=5173
BACKEND_PORT=8000
