# ══════════════════════════════════════════════════════════════════════════════
# Wazire Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=wazire
# Runtime environment: development | test | production
ENV=development
# Set to false in production (exposes stack traces when true)
DEBUG=false
HOST=0.0.0.0
PORT=8000
# Long random string used to sign JWTs and other secrets — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Full async DSN used by SQLAlchemy (routes through PgBouncer in Docker)
DATABASE_URL=postgresql+asyncpg://wazire:wazire@pgbouncer:6432/wazire
POSTGRES_DB=wazire
POSTGRES_USER=wazire
POSTGRES_PASSWORD=wazire
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

# PostgreSQL connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
# Seconds to wait for a free pool connection before raising PoolTimeout
DB_POOL_TIMEOUT=2.0
# asyncpg network round-trip timeout (seconds)
DB_COMMAND_TIMEOUT=5.0
# PostgreSQL server-side statement_timeout (milliseconds) — kills runaway queries
DB_STATEMENT_TIMEOUT_MS=900

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Bootstrap servers — comma-separated list, e.g. kafka:9092,other:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Optional prefix applied to all Kafka topic names
KAFKA_TOPIC_PREFIX=wazire
# Consumer group ID for the worker process (change to run a second independent group)
KAFKA_CONSUMER_GROUP_ID=wazire-worker
# Number of partitions for the grading topic (increase for higher throughput)
KAFKA_GRADING_PARTITIONS=4
# SASL authentication (leave blank for PLAINTEXT)
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use the exact frontend origin in
# production — never use * in production.
FRONTEND_ORIGIN=http://localhost:5173
# Legacy alias kept for backwards compatibility (same value as FRONTEND_ORIGIN)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Logging ───────────────────────────────────────────────────────────────────
# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Gunicorn ──────────────────────────────────────────────────────────────────
# Number of gunicorn worker processes (recommended: 2 × CPU cores + 1)
GUNICORN_WORKERS=4

# ── Performance & Timeout ─────────────────────────────────────────────────────
# Hard per-request timeout enforced by TimingMiddleware (seconds).
# Requests exceeding this budget receive HTTP 504. Set to 0 to disable.
API_TIMEOUT_SECONDS=1.0

# ── Grading Engine ────────────────────────────────────────────────────────────
# Maximum concurrent grading jobs per tenant (asyncio semaphore per tenant)
GRADING_CONCURRENCY_PER_TENANT=2
# Maximum number of theory questions sent in a single Groq batch API call
GRADING_BATCH_SIZE=20
# Maximum number of StudentAnswer rows inserted per bulk DB write
DB_WRITE_BATCH_SIZE=100

# ── Groq API Keys (key rotation pool — up to 4 keys) ─────────────────────────
# Obtain keys from https://console.groq.com/keys
# At least GROQ_API_KEY_1 must be set for AI grading to function.
# Additional keys increase throughput via round-robin rotation.
GROQ_API_KEY_1=gsk_your_first_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# ── Email (Brevo / Sendinblue) ────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_NAME=Wazire
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# ── Payment Gateways ──────────────────────────────────────────────────────────
# Shared HMAC-SHA256 secret used to verify incoming webhook payloads
PAYMENT_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Paystack — obtain from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Monnify — obtain from https://app.monnify.com/developer
MONNIFY_API_KEY=MK_TEST_your_monnify_api_key_here
MONNIFY_SECRET_KEY=your_monnify_secret_key_here

# ── Ports (Docker Compose host bindings) ──────────────────────────────────────
FRONTEND_PORT=5173
BACKEND_PORT=8000
