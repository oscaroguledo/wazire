# Application Configuration
APP_NAME=wazire
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me-in-production

# Database Configuration
DATABASE_URL=postgresql+asyncpg://wazire:wazire@pgbouncer:6432/wazire
POSTGRES_DB=wazire
POSTGRES_USER=wazire
POSTGRES_PASSWORD=wazire
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_PORT=6379

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=2
CELERY_EXAM_STATUS_UPDATE_INTERVAL=60
CELERY_EMAIL_SEND_INTERVAL=60
USE_INTERNAL_SCHEDULER=false

# Kafka Configuration
# Bootstrap servers may be a comma-separated list, e.g. kafka:9092,other:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Optional prefix for application topics
KAFKA_TOPIC_PREFIX=wazire
# If using SASL auth, set USER/PASS and SECURITY_PROTOCOL/SASL_MECHANISM
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=

# JWT Configuration
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# API Keys
GROQ_API_KEY=

# Frontend Configuration
FRONTEND_PORT=5173
BACKEND_PORT=8000
